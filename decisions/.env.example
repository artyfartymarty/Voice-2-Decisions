# setup.sh copies this to .env on the first run. The defaults work as they are.

# Host port for the API and console: http://localhost:8000 (through an SSH tunnel on EC2)
PORT=8000

# Winnow is compiled for this GPU architecture; setup.sh sets it from nvidia-smi.
# 75 T4 (g4dn) · 86 A10G (g5) · 89 L4/L40S (g6/g6e) · 120 Blackwell
CUDA_ARCH=86
# 4096 is plenty for one decision and keeps the 12B comfortably in VRAM.
WINNOW_CONTEXT=4096

# Where Winnow-12B comes from (scripts/fetch_model.sh; it always ends up at models/winnow/gguf/Winnow-12B-Q8_0.gguf):
#   local  = you copy the file onto the instance yourself; it is only checked (default)
#   url    = download it from MODEL_URL (e.g. your S3 bucket or a presigned link)
#   github = download the parts from a GitHub release (MODEL_REPO, MODEL_TAG), made by scripts/publish_model.py
MODELS_SOURCE=local
MODEL_URL=
MODEL_REPO=artyfartymarty/Voice-2-Decisions
MODEL_TAG=models-v1

# How sure Winnow must be (probability of its pick) before a result is surfaced.
DECIDE_MIN_P=0.5
# Nova Sonic roles -> call speakers. Decisions run on the caller's lines.
ROLE_MAP=USER:caller,ASSISTANT:agent
# Optional: every new decision is POSTed here as JSON (Slack/Teams webhook, your boss's app...)
DECISION_WEBHOOK_URL=
# Empty = the sample data in fixtures/reference. /reference = the ./reference folder (uncomment the volume in compose).
REFERENCE_DIR=

# Optional tail-number fallback (off when empty). When Winnow says the caller just said a full tail number and the
# parser couldn't read it, the line goes here; the answer is still checked against registration formats + fleet.
# With TAIL_NORMALIZER_MODEL set it's an OpenAI-compatible endpoint (POST <url>/chat/completions), otherwise plain
# JSON (POST <url> {"text","recent"} -> {"tail_number"}).
TAIL_NORMALIZER_URL=
TAIL_NORMALIZER_MODEL=
TAIL_NORMALIZER_API_KEY=
