# setup.sh copies this to .env on the first run. The defaults work as they are.

# Host port for the API: http://localhost:8000
PORT=8000

# Winnow is compiled for this GPU architecture; setup.sh sets it from nvidia-smi.
# 75 T4 (g4dn) · 86 A10G (g5) · 89 L4/L40S (g6/g6e) · 120 Blackwell
CUDA_ARCH=86
# 4096 is plenty for one decision and keeps the 12B comfortably in VRAM.
WINNOW_CONTEXT=4096

# Where Winnow-12B comes from (scripts/fetch_model.sh; it always ends up at models/winnow/gguf/Winnow-12B-Q8_0.gguf):
#   local  = you copy the file onto the instance yourself; it is only checked (default)
#   url    = download it from MODEL_URL (e.g. your S3 bucket or a presigned link)
#   github = download the parts from a GitHub release (MODEL_REPO, MODEL_TAG), made by scripts/publish_model.py
MODELS_SOURCE=local
MODEL_URL=
MODEL_REPO=artyfartymarty/Voice-2-Decisions
MODEL_TAG=models-v1

# How sure Winnow must be (probability of its pick) before a result is surfaced.
DECIDE_MIN_P=0.5
# Nova Sonic roles -> call speakers. Decisions run on the caller's lines.
ROLE_MAP=USER:caller,ASSISTANT:agent
# Optional: every new decision is POSTed here as JSON (Slack/Teams webhook, your boss's app...)
DECISION_WEBHOOK_URL=
# Empty = the sample data in fixtures/reference. /reference = the ./reference folder (uncomment the volume in compose).
REFERENCE_DIR=

# Tail numbers and customer names. EXTRACT_MODE=model (default): Winnow asks "did the caller just say a full tail
# number?" / "did they name their company?"; on yes the line goes to the model at EXTRACT_MODEL_URL. A tail must be a
# valid registration (and on the customer's fleet), a name must match customers.csv; the agent reads either back.
# Account numbers said as digits are matched directly. EXTRACT_MODE=parser: the built-in list matching and tail
# parser instead. With EXTRACT_MODEL_URL empty, the parser is used whatever EXTRACT_MODE says.
EXTRACT_MODE=model
# With EXTRACT_MODEL set it's an OpenAI-compatible endpoint (POST <url>/chat/completions), otherwise plain
# JSON (POST <url> {"kind","text","recent"} -> {"value"}).
EXTRACT_MODEL_URL=
EXTRACT_MODEL=
EXTRACT_MODEL_API_KEY=
# Sent as reasoning_effort when set; "none" is fastest on GPT 6 Luna. Seconds before giving up on one call.
EXTRACT_MODEL_REASONING=
EXTRACT_MODEL_TIMEOUT=3
# GPT 6 Luna on Amazon Bedrock (README: "GPT 6 Luna on Bedrock for tails and names"):
#   EXTRACT_MODEL_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
#   EXTRACT_MODEL=us.openai.gpt-6-luna
#   EXTRACT_MODEL_API_KEY=<your Bedrock API key>
#   EXTRACT_MODEL_REASONING=none
