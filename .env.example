# Copy to .env and edit:  cp .env.example .env

# --- Django ---
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# Hostnames/IPs the app answers to. On EC2 add the instance's public DNS or IP.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed for the upload form when served from a non-localhost origin, e.g. http://ec2-1-2-3-4.compute-1.amazonaws.com:8000
DJANGO_CSRF_TRUSTED_ORIGINS=
PORT=8000
MAX_UPLOAD_MB=200
LOG_LEVEL=INFO

# --- Speech recognition ---
# nemo_speech = the asr service (NeMo-Speech.cpp, English Nemotron Q8 + diarization): fastest, the default here.
# nemotron    = Nemotron 3.5 ASR inside the web container via Transformers (no asr service needed).
# fake        = canned transcript, for CPU-only smoke tests.
ASR_BACKEND=nemo_speech
NEMO_SPEECH_URL=http://asr:8080
# Word boost for customer / airport / FBO names from the reference data (0 = off).
ASR_WORD_BOOST=4.0
ASR_MODEL_ID=nvidia/nemotron-3.5-asr-streaming-0.6b
# Locale such as en-US, es-ES, de-DE, or "auto" to detect the language.
ASR_LANGUAGE=en-US
# auto | cuda | cpu
ASR_DEVICE=auto
# Long recordings are cut at quiet points into chunks of at most this many seconds.
ASR_CHUNK_SECONDS=30

# --- Speakers (mono calls) ---
# nemotron = nvidia/Nemotron-3-Diarization finds who spoke when, then agent/caller are named from what they say.
# off = no speaker labels. (Defaults to nemotron when ASR_BACKEND=nemotron.)
DIARIZER=nemotron
DIARIZER_MODEL_ID=nvidia/Nemotron-3-Diarization
# low_latency (1.04 s) | very_low_latency (0.64 s) | ultra_low_latency (0.32 s)
DIARIZER_STREAMING_MODE=low_latency
# Live calls: audio held back mid-word is transcribed after this many seconds with no new chunk (0 = off).
LIVE_FLUSH_S=0.9
# Two separate leg files: "separate" = each leg is a speaker; "mix" = fold to mono and diarize.
LEG_MODE=separate

# --- Use cases ---
# Folder with customers.csv and location_notes.csv (required), airport_aliases.csv and fleet.csv (optional). Default: the synthetic samples in fixtures/reference.
# On EC2, mount the real exports and point here, e.g. REFERENCE_DIR=/reference (see docker-compose.yml).
REFERENCE_DIR=
# validate_tail_number fires only for complete tail numbers at or above this confidence (or found in fleet.csv).
TAIL_MIN_CONFIDENCE=0.8
# Dispute guidance fires for locations with at least this many disputes in their private notes.
DISPUTE_MIN_COUNT=3
# Sentiment alert: average of the last N scored lines from one speaker at or below this (or two negative lines in a row).
SENTIMENT_WINDOW=3
SENTIMENT_ALERT_AT=-0.4
# Customer Experience sentiment model: winnow = POST {WINNOW_URL}/v1/systemone (EldanRing/winnow-inference),
# lexicon = word list, auto = winnow when WINNOW_URL is set. Falls back to the lexicon if Winnow is unreachable.
SENTIMENT_BACKEND=auto
WINNOW_URL=http://winnow:8091
WINNOW_API_KEY=
# Designated managers / leads for real-time sentiment alerts (comma-separated webhooks; default NOTIFY_WEBHOOK_URL).
MANAGER_WEBHOOKS=
# GP: margin flagged high when CURRENT_GPPG >= this x MIN_GPPG (then a revised mid-range price is offered).
MARGIN_HIGH_RATIO=3.0
# GP: addressable volume below this share of total P12M volume is fed back to Yield to verify.
ADDRESSABLE_CHECK_RATIO=0.5
# Optional: dispatcher and manager alerts are POSTed here as JSON (Slack/Teams incoming webhook or internal endpoint).
NOTIFY_WEBHOOK_URL=

# --- Winnow service (compose) ---
# e2b = Winnow-E2B Q8 (~6 GB VRAM, measured 93% on the sentiment set at 30 ms/line); q8 = Winnow-12B Q8 (~13 GB).
WINNOW_TARGET=e2b
WINNOW_CONTEXT=8192
# GPU architectures to compile Winnow for (from: nvidia-smi --query-gpu=compute_cap): 86 A10G (g5), 89 L4/L40S (g6/g6e),
# 120 RTX 50-series / RTX PRO 6000 Blackwell (g7e). The default builds all three into one image.
CUDA_ARCH=86;89;120

# Call page: optional WebSocket that announces call updates (refresh on each message); otherwise poll while live.
GATEWAY_WS_URL=
LIVE_REFRESH_MS=1500
# Entry page: folder of WAV calls listed for one-click simulated streaming (default tests/fixtures).
TEST_CALLS_DIR=

# Optional: Hugging Face token (the model is public; a token only raises download rate limits).
HF_TOKEN=
