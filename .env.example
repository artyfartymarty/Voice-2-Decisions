# scripts/setup.sh copies this to .env (with a fresh secret key) on first run. Defaults work as they are.

# --- Web ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# Add the instance's public DNS/IP here only if you open the port instead of using an SSH tunnel.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Host port for the UI: http://localhost:8080 (through the SSH tunnel on EC2)
PORT=8080

# --- GPU build ---
# Winnow is compiled for this GPU architecture. setup.sh sets it from `nvidia-smi --query-gpu=compute_cap`:
# 75 T4 (g4dn) · 86 A10G (g5) · 89 L4/L40S (g6/g6e) · 120 Blackwell (g7e, RTX 50-series).
CUDA_ARCH=86
# Winnow-12B context. 4096 is plenty for sentiment and keeps the 12B in VRAM; 8192 only on 24 GB+ cards.
WINNOW_CONTEXT=4096

# --- Model sources (scripts/fetch_models.sh, see models.lock) ---
# download = fetch anything missing (default) · local = never download; only verify files you copied into ./models
MODELS_SOURCE=download
# Leave empty for the pinned public sources. To use a mirror (e.g. an S3 bucket laid out like ./models):
MODEL_BASE_URL=
# Or replace single files: MODEL_URL_WINNOW_12B, MODEL_URL_ASR_EN, MODEL_URL_DIAR_GGUF, MODEL_URL_DIAR_HF_WEIGHTS,
# MODEL_URL_DIAR_HF_CONFIG, MODEL_URL_DIAR_HF_PROCESSOR

# --- Pipeline (defaults are what was measured) ---
ASR_BACKEND=nemo_speech
NEMO_SPEECH_URL=http://asr:8080
ASR_WORD_BOOST=4.0
DIARIZER=nemotron
SENTIMENT_BACKEND=auto
WINNOW_URL=http://winnow:8091
LIVE_FLUSH_S=0.9

# --- Use cases ---
# Folder with customers.csv + location_notes.csv (+ optional disputes.csv, fleet.csv, airport_aliases.csv).
# Empty = the synthetic samples in fixtures/reference.
REFERENCE_DIR=
DISPUTE_MIN_COUNT=3
TAIL_MIN_CONFIDENCE=0.8
SENTIMENT_WINDOW=3
SENTIMENT_ALERT_AT=-0.4
MARGIN_HIGH_RATIO=3.0
ADDRESSABLE_CHECK_RATIO=0.5
# Optional: alerts (dispatcher, managers, yield) are POSTed here as JSON, e.g. a Slack or Teams incoming webhook.
NOTIFY_WEBHOOK_URL=
MANAGER_WEBHOOKS=

# The server refuses ASR_BACKEND=fake unless this is 1 (tests only).
ALLOW_FAKE_BACKEND=0
