# Copy to .env and edit:  cp .env.example .env

# --- Django ---
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# Hostnames/IPs the app answers to. On EC2 add the instance's public DNS or IP.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed for the upload form when served from a non-localhost origin, e.g. http://ec2-1-2-3-4.compute-1.amazonaws.com:8000
DJANGO_CSRF_TRUSTED_ORIGINS=
PORT=8000
MAX_UPLOAD_MB=200
LOG_LEVEL=INFO

# --- Speech recognition ---
# nemotron = real model (GPU recommended). fake = canned transcript, for CPU-only smoke tests.
ASR_BACKEND=nemotron
ASR_MODEL_ID=nvidia/nemotron-3.5-asr-streaming-0.6b
# Locale such as en-US, es-ES, de-DE, or "auto" to detect the language.
ASR_LANGUAGE=en-US
# auto | cuda | cpu
ASR_DEVICE=auto
# Long recordings are cut at quiet points into chunks of at most this many seconds.
ASR_CHUNK_SECONDS=30

# Optional: Hugging Face token (the model is public; a token only raises download rate limits).
HF_TOKEN=
